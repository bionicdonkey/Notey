[Desktop Entry]
Name=NoteyMcNoteface
GenericName=Text Editor
Comment=A tabbed text editor that remembers your notes between sessions
Exec=notey %F
Icon=com.zorin.Notey
Terminal=false
Type=Application
Categories=GTK;GNOME;Utility;TextEditor;
Keywords=text;editor;notepad;notes;
StartupNotify=true
StartupWMClass=com.zorin.Notey
